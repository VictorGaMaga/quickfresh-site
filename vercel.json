{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/uphostery",
      "destination": "/upholstery",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/html/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/html/carpet-cleaning.html",
      "destination": "/carpet-cleaning",
      "permanent": true
    },
    {
      "source": "/html/rugs-cleaning.html",
      "destination": "/rugs",
      "permanent": true
    },
    {
      "source": "/html/couch-sofa-cleaning.html",
      "destination": "/couch-sofa-cleaning",
      "permanent": true
    },
    {
      "source": "/html/dining-chair-cleaning.html",
      "destination": "/couch-sofa-cleaning",
      "permanent": true
    },
    {
      "source": "/html/mattress-cleaning.html",
      "destination": "/mattress-cleaning",
      "permanent": true
    },
    {
      "source": "/html/tile-grout-cleaning.html",
      "destination": "/tile-grout-cleaning",
      "permanent": true
    },
    {
      "source": "/html/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/html/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/carpet-cleaning.html",
      "destination": "/carpet-cleaning",
      "permanent": true
    },
    {
      "source": "/rugs-cleaning.html",
      "destination": "/rugs",
      "permanent": true
    },
    {
      "source": "/couch-sofa-cleaning.html",
      "destination": "/couch-sofa-cleaning",
      "permanent": true
    },
    {
      "source": "/dining-chair-cleaning.html",
      "destination": "/couch-sofa-cleaning",
      "permanent": true
    },
    {
      "source": "/mattress-cleaning.html",
      "destination": "/mattress-cleaning",
      "permanent": true
    },
    {
      "source": "/tile-grout-cleaning.html",
      "destination": "/tile-grout-cleaning",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
